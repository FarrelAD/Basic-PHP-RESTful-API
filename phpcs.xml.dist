<?xml version="1.0"?>
<ruleset name="Basic PHP RESTful API">
    <description>PSR-12 Coding Standard</description>

    <!-- Scan these directories -->
    <file>src</file>
    <file>public</file>

    <!-- Display progress and source of each error -->
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- Enforce PSR-12 -->
    <rule ref="PSR12"/>
</ruleset>
