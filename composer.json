{
    "name": "farrelad/basic-php-restful-api",
    "description": "Basic RESTful API in PHP",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": "php -S localhost:8000 -t public",
        "test": "phpunit",
        "lint": "phpcs",
        "format": "php-cs-fixer fix --dry-run --diff --verbose",
        "format:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse"
    },
    "require": {
        "php": ">=8.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "friendsofphp/php-cs-fixer": "^3.60",
        "phpstan/phpstan": "^2.0"
    }
}
